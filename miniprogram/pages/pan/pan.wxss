/* 排盘页样式（共享样式已由 app.wxss 提供：panel / 爻画 / 状态标签 / 按钮） */

.pan-head {
  background: #1c1815;
  border-radius: 12rpx;
  padding: 26rpx 20rpx;
  margin-bottom: 20rpx;
}
.ph-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 18rpx;
}
.ph-symbol {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #e8c877;
  border: 1rpx solid #6d5719;
  border-radius: 10rpx;
  background: #241e17;
}
.ph-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ece4d8;
  line-height: 1.3;
}
.ph-sub {
  font-size: 22rpx;
  color: #8a7a66;
  margin-top: 6rpx;
}
.ph-right {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.ph-ba {
  font-size: 22rpx;
  color: #a89880;
}
.ph-sy {
  display: flex;
  gap: 12rpx;
  margin-top: 6rpx;
  flex-wrap: wrap;
}

.pan-guaCi {
  font-size: 24rpx;
  color: #c9bda9;
  line-height: 1.75;
  padding: 10rpx 0;
}
.gc-k {
  display: inline-block;
  font-size: 20rpx;
  color: #e8c877;
  border: 1rpx solid #6d5719;
  border-radius: 5rpx;
  padding: 1rpx 8rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

/* ---------- 六爻表 ---------- */
/* 移动端横向空间有限：7 列用 flex 等比，爻画与文字压缩适配 */
.yao-thead {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #3d342a;
  font-size: 20rpx;
  color: #8a7a66;
}
.yao-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #2a231b;
  min-width: 0;
}
.yao-row.moving { background: rgba(201, 162, 74, 0.06); }

.yao-thead .c-pos, .yao-row .c-pos { width: 62rpx; flex-shrink: 0; }
.yao-thead .c-shen, .yao-row .c-shen { width: 44rpx; flex-shrink: 0; font-size: 21rpx; }
.yao-thead .c-line, .yao-row .c-line {
  width: 116rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}
.yao-thead .c-qin, .yao-row .c-qin { width: 66rpx; flex-shrink: 0; font-size: 21rpx; color: #a89880; }
.yao-thead .c-gz, .yao-row .c-gz { width: 92rpx; flex-shrink: 0; font-size: 23rpx; }
.yao-row .c-cg {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 20rpx;
  line-height: 1.4;
}
.c-cqin {
  font-size: 18rpx;
  color: #8a7a66;
  margin-left: 4rpx;
}
.c-ctag {
  display: block;
  font-size: 17rpx;
  color: #e8c877;
  margin-top: 2rpx;
}
.yao-thead .c-state, .yao-row .c-state {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0;
}
.c-state .st { margin-right: 4rpx; }
.sy-tag { margin-left: 6rpx; }
.mv {
  font-size: 22rpx;
  color: #c0392b;
  font-weight: 700;
  margin-left: 4rpx;
  font-style: normal;
}

/* ---------- 变卦 / 互错综 ---------- */
.pan-changed {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #1c1815;
  border-radius: 12rpx;
}
.pc-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  font-size: 26rpx;
  color: #ece4d8;
}
.pc-sub {
  font-size: 21rpx;
  color: #8a7a66;
}
.pc-guaCi {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #c9bda9;
  line-height: 1.7;
}

.pan-related {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.rel-item {
  font-size: 21rpx;
  color: #a89880;
  background: #2f2820;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
}

/* ---------- 分块 ---------- */
.block-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #e8c877;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
  border-left: 4rpx solid #8a6d2f;
}

.gt {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #2a231b;
}
.gt:last-child { border-bottom: none; }
.gt-t {
  display: block;
  font-size: 23rpx;
  color: #e8c877;
  margin-bottom: 4rpx;
}
.gt-d {
  font-size: 22rpx;
  color: #a89880;
  line-height: 1.7;
}

.mt {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0;
  font-size: 23rpx;
}
.mt-k {
  width: 80rpx;
  flex-shrink: 0;
  color: #8a7a66;
}
.mt-v { color: #c9bda9; }

.ss {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #2a231b;
}
.ss-n {
  font-size: 22rpx;
  color: #e8c877;
  font-weight: 600;
}
.ss-z {
  font-size: 22rpx;
  color: #c9a24a;
}
.ss-note {
  font-size: 21rpx;
  color: #8a7a66;
  line-height: 1.6;
  width: 100%;
}
